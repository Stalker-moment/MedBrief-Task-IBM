# Server Port & Environment
PORT=4000
NODE_ENV=development

# Domain Frontend yang diizinkan CORS (pisahkan dengan koma jika lebih dari satu).
# Saat Frontend di-host di Vercel: masukkan URL domain Vercel Anda.
# Contoh: http://localhost:3000,https://medibrief.vercel.app
WEB_ORIGIN=http://localhost:3000,https://*.vercel.app

# Google Gemini Configuration
# Provide your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# DeepSeek Configuration
# Provide your DeepSeek API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Fallback & Timeout
ALLOW_PROVIDER_FALLBACK=false
AI_TIMEOUT_MS=60000
